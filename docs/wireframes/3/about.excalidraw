  },
  {
   "id": "v1-text-124",
   "type": "text",
   "x": 1200,
   "y": 713.5,
   "width": 458.15000000000003,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v1-group-116"
   ],
   "frameId": "v1-frame-104",
   "roundness": null,
   "seed": 8196149,
   "version": 1,
   "versionNonce": 2059322682,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Passionné par le web depuis plus de dix ans, j'ai\nétudié l'informatique à l'Exia CESI de Toulouse,\npuis travaillé en développement web et en gestion\nde projet.",
   "originalText": "Passionné par le web depuis plus de dix ans, j'ai\nétudié l'informatique à l'Exia CESI de Toulouse,\npuis travaillé en développement web et en gestion\nde projet.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v1-text-125",
   "type": "text",
   "x": 1200,
   "y": 816.5,
   "width": 467.50000000000006,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v1-group-116"
   ],
   "frameId": "v1-frame-104",
   "roundness": null,
   "seed": 1477498383,
   "version": 1,
   "versionNonce": 364120812,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Autodidacte dans l'âme, je forme depuis 2021 des\nétudiants, des personnes en reconversion et des\nsalariés, avec une conviction : on n'arrête jamais\nd'apprendre.",
   "originalText": "Autodidacte dans l'âme, je forme depuis 2021 des\nétudiants, des personnes en reconversion et des\nsalariés, avec une conviction : on n'arrête jamais\nd'apprendre.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
