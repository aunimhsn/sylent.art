   "autoResize": true
  },
  {
   "id": "v3-text-2",
   "type": "text",
   "x": 0,
   "y": -145,
   "width": 932.2500000000001,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1695753999,
   "version": 1,
   "versionNonce": 207388625,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Domaine (une étagère où chercher) → formation (un sujet, son adresse /formations/<formation>/<module>/) → module.",
   "originalText": "Domaine (une étagère où chercher) → formation (un sujet, son adresse /formations/<formation>/<module>/) → module.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v3-text-3",
   "type": "text",
   "x": 0,
   "y": -122,
   "width": 1278.75,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 311111476,
   "version": 1,
   "versionNonce": 404285458,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Un module habite une seule formation, mais peut être rangé dans plusieurs domaines ; une formation apparaît dans un domaine dès qu’un de ses modules y est.",
   "originalText": "Un module habite une seule formation, mais peut être rangé dans plusieurs domaines ; une formation apparaît dans un domaine dès qu’un de ses modules y est.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v3-text-4",
   "type": "text",
   "x": 0,
   "y": -99,
   "width": 1592.2500000000002,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1570621945,
   "version": 1,
   "versionNonce": 249103478,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Corrige « Par formation » (déplacer, renommer, changer les domaines) : je régénère « Par domaine » à partir d’elle. Plein : publié ; « brouillon » : écrit, pas en ligne ; pointillés : à écrire.",
   "originalText": "Corrige « Par formation » (déplacer, renommer, changer les domaines) : je régénère « Par domaine » à partir d’elle. Plein : publié ; « brouillon » : écrit, pas en ligne ; pointillés : à écrire.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
