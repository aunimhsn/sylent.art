   "y": 528.75,
   "width": 330.0,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v1-group-112"
   ],
   "frameId": "v1-frame-102",
