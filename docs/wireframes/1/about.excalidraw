  {
   "id": "v1-text-21",
   "type": "text",
   "x": 20,
   "y": 560.5,
   "width": 299.20000000000005,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
