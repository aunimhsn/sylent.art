   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "React, Vue, Angular, Svelte… beaucoup de frameworks existent déjà.\nFaut-il vraiment parler d'un autre ? Aujourd'hui, je vous invite à\njeter un œil du côté d'Alpine JS, pour vous faire votre propre avis.",
   "originalText": "React, Vue, Angular, Svelte… beaucoup de frameworks existent déjà.\nFaut-il vraiment parler d'un autre ? Aujourd'hui, je vous invite à\njeter un œil du côté d'Alpine JS, pour vous faire votre propre avis.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
