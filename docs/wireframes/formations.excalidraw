   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Formation d’un seul module (HTML, CSS) : une\ncarte de module, nommée d’après la formation,\nqui mène au module. Sa ligne grise donne sa\ndurée, « 1 jour ».",
   "originalText": "Formation d’un seul module (HTML, CSS) : une\ncarte de module, nommée d’après la formation,\nqui mène au module. Sa ligne grise donne sa\ndurée, « 1 jour ».",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v2-text-161",
   "type": "text",
   "x": 1850,
   "y": 166,
   "width": 396.00000000000006,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
