---
// The about page (docs/mockups/about-site.html): the name and the background on the left, over
// the grid, over the owner's photo, large and faded; the key figures, larger than on the home
// page; the pedagogy; the partners; the administrative information; the call to action. The
// figures, the steps and the partners are shared with the home page.
import KeyFigures from "../components/key-figures.astro";
import OwnerPhoto from "../components/owner-photo.astro";
import PartnerReel from "../components/partner-reel.astro";
import PedagogySteps from "../components/pedagogy-steps.astro";
import RichText from "../components/rich-text.astro";
import SectionHeading from "../components/section-heading.astro";
import about from "../content/about.json";
import SiteLayout from "../layouts/site-layout.astro";
import { bearingStyle } from "../lib/title-metrics";
import { href } from "../lib/url";

const { pedagogy, partners, admin } = about;
---

<SiteLayout title={about.title} description={about.description} cta>
  <section
    class="about-hero grid-texture"
    aria-labelledby="about-title"
    data-fluid="--grid-step"
  >
    <OwnerPhoto class="about-photo" loading="eager" />
    <div class="wrap">
      <h1
        class="about-title reveal"
        id="about-title"
        style={bearingStyle(about.name)}
      >
        {about.name}
      </h1>
      <p class="about-role reveal">{about.role}</p>
      {about.story.map((paragraph) => (
        <p class="about-story reveal">{paragraph}</p>
      ))}
    </div>
  </section>

  <div class="wrap reveal">
    <KeyFigures large />
  </div>

  <section class="section" aria-labelledby="pedagogy-title">
    <div class="wrap">
      <SectionHeading
        title={pedagogy.title}
        ghost={pedagogy.ghost}
        id="pedagogy-title"
      />
      <PedagogySteps />
    </div>
  </section>

  <section class="section is-next" aria-labelledby="partners-title">
    <div class="wrap">
      <SectionHeading
        title={partners.title}
        ghost={partners.ghost}
        id="partners-title"
      />
      <PartnerReel />
    </div>
  </section>

  <section class="section is-next" aria-labelledby="admin-title">
    <div class="wrap">
      <div class="admin glass reveal">
        <h2 id="admin-title">{admin.title}</h2>
        {admin.text.map((line) => (
          <p>
            <RichText text={line} />
          </p>
        ))}
        <a class="link" href={href("/mentions-legales/")}>
          {admin.legal}
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .section.is-next {
    padding-top: 0;
  }

  /* The name and the background, on the left, over the grid and its orange fluid (global.css). */
  .about-hero {
    --grid-mask: radial-gradient(
      80% 75% at 30% 40%,
      #000000 30%,
      transparent 75%
    );

    padding: calc(var(--header-height) + var(--space-fluid-2)) 0
      var(--space-fluid-3);
  }

  .about-hero .wrap {
    position: relative;
  }

  /* The photo, from under the header down to the bottom of the hero. */
  .about-hero :global(.about-photo) {
    top: var(--header-height);
    bottom: 0;
  }

  /* The ink of the first letter on the left edge, not its side bearing (--bearing, optical
     alignment, docs/branding.md). */
  .about-title {
    margin: 0 0 0 calc(-1 * var(--bearing, 0em));
    font: var(--title-weight) var(--size-display) / 0.98 var(--font-title);
    letter-spacing: var(--tracking-title);
  }

  .about-role {
    margin: var(--space-5) 0 0;
    font: 700 var(--size-role) / 1.3 var(--font-title);
    letter-spacing: var(--tracking-card);
  }

  .about-story {
    max-width: var(--measure);
    margin: var(--space-6) 0 0;
    color: var(--secondary);
    font-size: var(--size-intro);
    text-wrap: pretty;
  }

  .about-story + .about-story {
    margin-top: var(--space-4);
  }

  /* The administrative information: a glass panel. */
  .admin {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-narrow);
    margin-inline: auto;
    padding: var(--card-padding-block) var(--card-padding-inline);
  }

  .admin h2 {
    margin: 0 0 var(--space-1);
    font: 700 var(--size-card-title) / 1.2 var(--font-title);
    letter-spacing: var(--tracking-card);
  }

  .admin p {
    margin: 0;
    color: var(--secondary);
    font-size: var(--size-text-small);
  }

  .admin .link {
    justify-self: start;
    margin-top: var(--space-2);
  }
</style>
