---
// The courses of the former site (/courses/<id>/), each redirected to the page of the module it
// became, from the formerId of the module (specs.md, URLs and redirects). The former URL of a
// draft leads to the page of its formation until the module is published, or of its first domain
// when the formation has no page.
import type { GetStaticPaths } from "astro";
import {
  collectionIdOf,
  domainPath,
  formationPath,
  getCatalog,
  isSingle,
  modulePath,
  type Module,
} from "../../lib/offers";
import { href } from "../../lib/url";

export const getStaticPaths = (async () => {
  const { formations, offers, drafts } = await getCatalog();
  const targetOfDraft = (draft: Module) => {
    const formation = formations.find(
      ({ collection }) => collection.id === collectionIdOf(draft),
    );
    if (formation && !isSingle(formation)) return formationPath(formation);
    const domain = offers.find((offer) =>
      draft.data.domains.some(({ id }) => id === offer.domain.id),
    );
    if (!domain)
      throw new Error(`${draft.id}: no page to lead its former URL to`);
    return domainPath(domain.domain.id);
  };
  const modules = formations.flatMap(({ modules }) => modules);
  return [...modules, ...drafts].flatMap((module) => {
    const { formerId, draft } = module.data;
    if (!formerId) return [];
    const target = draft ? targetOfDraft(module) : modulePath(module);
    return [{ params: { id: String(formerId) }, props: { target } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  target: string;
}

// 301 as the others: GitHub Pages only serves a page that leads on at once (a 302 waits 2 s).
return Astro.redirect(href(Astro.props.target), 301);
---
