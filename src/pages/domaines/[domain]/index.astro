---
// The page of one domain, at /domaines/<domain>/ (specs.md, Domain pages): a hero as on a module
// page, without a faded word, then the cards of its formations, with only their modules filed
// under it (src/components/formation-card.astro), and of a custom request, then the other
// domains. A domain whose modules are all drafts has no page.
import type { GetStaticPaths } from "astro";
import CustomCard from "../../../components/custom-card.astro";
import DomainCards from "../../../components/domain-cards.astro";
import FormationCard from "../../../components/formation-card.astro";
import PageHero from "../../../components/page-hero.astro";
import SectionHeading from "../../../components/section-heading.astro";
import courses from "../../../content/courses.json";
import SiteLayout from "../../../layouts/site-layout.astro";
import { getOffers, type Offer } from "../../../lib/offers";

export const getStaticPaths = (async () =>
  (await getOffers()).map((offer) => ({
    params: { domain: offer.domain.id },
    props: { offer },
  }))) satisfies GetStaticPaths;

interface Props {
  offer: Offer;
}

const { domain, formations } = Astro.props.offer;
const page = courses.domain;
const { title, summary, isNew, note } = domain.data;
---

<SiteLayout
  title={page.title.replace("{title}", title)}
  description={page.description.replace("{summary}", summary)}
  cta={page.cta}
>
  <PageHero title={title} id="domain-title" isNew={isNew} note={note}>
    <p>{summary}</p>
  </PageHero>

  <section class="domain-formations" aria-labelledby="formations-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="formations-title">
        {page.formations}
      </h2>
      <ul class="cards">
        {formations.map((filed) => (
          <FormationCard filed={filed} />
        ))}
        <CustomCard />
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="others-title">
    <div class="wrap">
      <SectionHeading
        title={page.others.title}
        ghost={page.others.ghost}
        id="others-title"
      />
      <DomainCards except={domain.id} band={false} />
    </div>
  </section>
</SiteLayout>
