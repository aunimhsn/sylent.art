---
// Temporary home page, inside the shared layout (step 7a); step 7b builds the real one.
import SiteLayout from "../layouts/site-layout.astro";
import fr from "../i18n/fr.json";
---

<SiteLayout title={fr.site.title} description={fr.site.description} cta>
  <section class="section">
    <div class="wrap">
      <h1>{fr.site.name}</h1>
      <p class="lead">{fr.home.lead}</p>
    </div>
  </section>
</SiteLayout>

<style>
  .section {
    padding-top: calc(var(--header-height) + var(--space-section));
  }

  h1 {
    margin: 0 0 var(--space-4);
    font: var(--title-weight) var(--size-display) / 1 var(--font-title);
    letter-spacing: var(--tracking-title);
  }
</style>
