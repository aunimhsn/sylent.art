---
// The formations page at /formations/, the « Formations » link of the header: the grid of the
// hero at the top of the page, fading out, then one card per domain, as on the home page, each
// leading to the page of its domain (src/pages/domaines/[domain]/index.astro).
import DomainCards from "../../components/domain-cards.astro";
import SectionHeading from "../../components/section-heading.astro";
import courses from "../../content/courses.json";
import SiteLayout from "../../layouts/site-layout.astro";

const { list } = courses;
---

<SiteLayout title={list.title} description={list.description} cta={list.cta}>
  <section class="courses" aria-labelledby="courses-title">
    <div class="wrap">
      <div
        class="courses-head grid-texture is-page-top"
        data-fluid="--grid-step"
      >
        <SectionHeading
          title={list.heading}
          ghost={list.ghost}
          id="courses-title"
          level={1}
        />
        <p class="lead reveal">{list.lead}</p>
      </div>
      <DomainCards headingLevel={2} />
    </div>
  </section>
</SiteLayout>

<style>
  .courses {
    padding: calc(var(--header-height) + var(--space-fluid-3)) 0
      var(--space-section);
  }
</style>
