---
// The cards of the domains, each leading to the page of its domain: on the home page and the
// domains page, then the card of a custom request; under a domain page, the other domains only.
//
// Under the pointer (or with the keyboard focus) the content of a card slides up and its
// formations come up in its place, on its back (docs/branding.md, Components). The back is
// decorative, hidden from screen readers: they read the formations in the tags at the bottom of
// the card.
import fr from "../i18n/fr.json";
import { domainPath, getOffers } from "../lib/offers";
import { withoutAccents } from "../lib/text";
import { href } from "../lib/url";
import CustomCard from "./custom-card.astro";

interface Props {
  /** The domain left out: the one of the page, under its other domains. */
  except?: string;
  /** The card of a custom request, after the domains. */
  custom?: boolean;
  /** 2 on the domains page, right under its h1; 3 under a section heading. */
  headingLevel?: 2 | 3;
}

const { except, custom = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const offers = (await getOffers()).filter(({ domain }) => domain.id !== except);
// Up to six formations fit the back of a card, simply listed: only more scroll (asked by the owner
// on 2026-10-30; from three until then).
const stillMax = 6;
// A tag: the name of a formation in lowercase kebab-case, without accents (« Git / GitHub »
// becomes « git-github », « Agilité » « agilite », asked by the owner on 2026-10-30).
const tagOf = (name: string) =>
  withoutAccents(name)
    .toLowerCase()
    .split(/[^\p{L}\p{N}]+/u)
    .filter(Boolean)
    .join("-");
---

<ul class="cards">
  {offers.map(({ domain: { id, data }, formations }) => {
    const names = formations.map(
      ({ formation }) => formation.collection.data.title,
    );
    return (
      <li class="card glass reveal" data-domain={id}>
        <div class="cover" data-scene={data.scene} aria-hidden="true">
          <canvas />
          {data.isNew && <span class="new">{fr.cards.new}</span>}
        </div>
        <Heading>
          {data.title}
          {data.isNew && (
            <span class="visually-hidden">{fr.cards.newHidden}</span>
          )}
        </Heading>
        <p>{data.summary}</p>
        <ul class="card-tags" aria-label={fr.cards.domainFormations}>
          {names.map((name) => (
            <li>
              <span aria-hidden="true">#{tagOf(name)}</span>
              <span class="visually-hidden">{name}</span>
            </li>
          ))}
        </ul>
        <a
          class="card-more"
          href={href(domainPath(id))}
          aria-label={fr.cards.domainLabel.replace("{title}", data.title)}
        >
          <span>{fr.cards.domainMore}</span>
        </a>
        <div
          class:list={["card-back", { "is-still": names.length <= stillMax }]}
          aria-hidden="true"
        >
          <div class="back-reel">
            <ul class="back-list">
              {names.map((name) => (
                <li>
                  <strong>{name}</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </li>
    );
  })}
  {custom && <CustomCard headingLevel={headingLevel} />}
</ul>

<script>
  import "../scripts/covers";

  // Under the pointer or with the keyboard focus, the content above the band goes up and out,
  // and the list of the formations comes up from under it at the same pace: the card keeps its
  // shape (it turned half a turn until 2026-10-29, which jerked when the pointer passed fast).
  // Only on pointer devices: touch screens keep the cards still.
  const motion = document.documentElement.dataset.motion === "on";
  const clamp = (x: number) => Math.min(1, Math.max(0, x));

  function slideCard(card: HTMLElement) {
    const back = card.querySelector(".card-back") as HTMLElement;
    const reel = back.querySelector(".back-reel") as HTMLElement;
    const list = reel.querySelector(".back-list") as HTMLElement;
    const names = [...list.children];
    const still = back.classList.contains("is-still");
    let items: HTMLElement[] = [];
    let copies = 0;
    let offset = 0;
    let before = 0;
    let spinning = false;

    // From seven formations, they scroll up without end. The reel repeats them until one cycle is
    // taller than the reel, then holds two cycles, so that it loops without a gap whatever the
    // size of the card.
    function fill() {
      const row = (list.firstElementChild as HTMLElement).offsetHeight;
      const height = reel.clientHeight;
      if (!row || !height) return false;
      const needed = Math.ceil((height / row + 1) / names.length);
      if (needed !== copies) {
        copies = needed;
        list.replaceChildren(
          ...Array.from({ length: copies * 2 }, () =>
            names.map((name) => name.cloneNode(true)),
          ).flat(),
        );
        items = [...list.children] as HTMLElement[];
        offset = 0;
      }
      return true;
    }

    // Each formation comes in at the bottom, and near the top moves away toward the back.
    function spin(now: number) {
      if (!card.classList.contains("is-open")) {
        spinning = false;
        return;
      }
      requestAnimationFrame(spin);
      if (!fill()) return;
      const row = items[0].offsetHeight;
      const height = reel.clientHeight;
      offset =
        (offset + ((before ? now - before : 0) * row) / 1500) %
        ((row * items.length) / 2);
      before = now;
      list.style.transform = `translateY(${-offset}px)`;
      items.forEach((element, index) => {
        const place = (index * row + row / 2 - offset) / height; // 0 at the top, 1 at the bottom
        const away = clamp((0.3 - place) / 0.3);
        const coming = clamp((place - 0.72) / 0.28);
        element.style.transform = `perspective(500px) translateZ(${-away * 220}px) rotateX(${away * 38}deg) scale(${1 - coming * 0.12})`;
        element.style.opacity = String(Math.max(0, 1 - away * 1.1 - coming));
      });
    }

    // Both go by the distance from the top of the card to the band, so that the list, which
    // fills the back, comes up only under the content leaving it.
    const band = card.querySelector(".card-more") as HTMLElement;
    new ResizeObserver(() =>
      card.style.setProperty("--slide", `${band.offsetTop}px`),
    ).observe(card);
    card.classList.add("can-open");

    const open = (shown: boolean) => {
      if (shown === card.classList.contains("is-open")) return;
      card.classList.toggle("is-open", shown);
      if (shown && !still && !spinning && motion) {
        spinning = true;
        before = 0;
        requestAnimationFrame(spin);
      }
    };
    // Only the focus of the keyboard holds it open: the link of a card clicked, then found again
    // with the back button, keeps a focus that would hold it open under no pointer. Escape closes
    // it, since the list hides the name of the domain (WCAG 1.4.13), until the focus or the
    // pointer comes back.
    let dismissed = false;
    const focused = () =>
      !dismissed && card.querySelector(":focus-visible") !== null;
    card.addEventListener("pointerenter", (event) => {
      dismissed = false;
      if (event.pointerType === "mouse") open(true);
    });
    card.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") open(focused());
    });
    card.addEventListener("focusin", () => {
      dismissed = false;
      open(focused());
    });
    card.addEventListener("focusout", () => open(card.matches(":hover")));
    card.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !card.classList.contains("is-open")) return;
      dismissed = true;
      open(false);
    });
  }

  if (matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>("[data-domain]").forEach(slideCard);
  }
</script>

<style>
  /* The formations of the domain, at the bottom of the card, aligned from one card to the next:
     plain text in lowercase kebab-case, smaller and grayer than the sentence, as the tags under
     a post, not links (asked by the owner on 2026-10-29: a school finds its formation without
     passing the pointer). Screen readers hear the real name instead (« Git / GitHub »). */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: auto 0 0;
    padding: 0;
    color: var(--dim);
    font-size: var(--size-caption);
    line-height: 1.55;
    list-style: none;
  }

  .card-tags + .card-more {
    margin-top: var(--space-5);
  }

  /* The back covers the card above its white band, which stays in place and keeps growing a
     little under the pointer. It clips the list of the formations, which waits under it, and lets
     the pointer through to the link of the card, which covers the whole card. */
  .card-back {
    position: absolute;
    pointer-events: none;
    inset: 0 0 var(--space-14);
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--card-padding-inline);
    overflow: hidden;
    visibility: hidden;
  }

  .card.can-open .card-back {
    visibility: visible;
  }

  /* The formations scroll up without end over the whole height of the back, so that the reel is
     centered above the band. */
  .back-reel {
    position: relative;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(
      transparent,
      #000000 16%,
      #000000 84%,
      transparent
    );
  }

  /* The slide: the content above the band goes up by --slide, and the reel of the formations comes
     up from as far below (see the script). Both follow one animated value, --card-open, from 0
     to 1: two transitions of their own drifted apart when the pointer left during the slide, and
     the list ran over the content. */
  @property --card-open {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .card.can-open {
    transition:
      background-color var(--duration-fast),
      --card-open var(--duration-card) var(--ease-in-out);
  }

  .card.is-open {
    --card-open: 1;
  }

  :global(html[data-motion="off"]) .card.can-open {
    transition: background-color var(--duration-fast);
  }

  .card.can-open > :not(.card-back, .card-more) {
    translate: 0 calc(-1 * var(--slide) * var(--card-open));
  }

  .card.can-open .back-reel {
    translate: 0 calc(var(--slide) * (1 - var(--card-open)));
  }

  .back-list {
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }

  /* A row holds a name on two lines, should one wrap in a narrow card. */
  .back-list li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 56px;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .back-list strong {
    font: 700 var(--size-card-title) / 1.2 var(--font-title);
    letter-spacing: var(--tracking-card);
  }

  /* Up to six formations: simply listed, without the reel and its fades. */
  .card-back.is-still .back-reel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    mask-image: none;
  }

  .card-back.is-still .back-list {
    display: grid;
    gap: var(--space-5);
  }

  .card-back.is-still .back-list li {
    height: auto;
  }
</style>
