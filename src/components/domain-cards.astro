---
// The cards of the domains, each leading to the page of its domain: on the home page and the
// domains page, then a band for a custom request; under a domain page, the other domains only.
//
// Under the pointer (or with the keyboard focus) the content of a card slides up and its modules
// come up in its place, on its back (docs/branding.md, Components). The back is decorative, hidden from screen readers:
// the modules are listed on the page of the domain.
import fr from "../i18n/fr.json";
import { domainPath, getOffers } from "../lib/offers";
import { href } from "../lib/url";
import Icon from "./icon.astro";

interface Props {
  /** The domain left out: the one of the page, under its other domains. */
  except?: string;
  /** The band for a custom request, after the cards. */
  band?: boolean;
  /** 2 on the domains page, right under its h1; 3 under a section heading. */
  headingLevel?: 2 | 3;
}

const { except, band = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const offers = (await getOffers()).filter(({ domain }) => domain.id !== except);
---

<ul class="cards">
  {offers.map(({ domain: { id, data }, modules }) => (
    <li class="card glass reveal" data-domain={id}>
      <div class="cover" data-scene={data.scene} aria-hidden="true">
        <canvas />
        {data.isNew && <span class="new">{fr.cards.new}</span>}
      </div>
      <Heading>
        {data.title}
        {data.isNew && (
          <span class="visually-hidden">{fr.cards.newHidden}</span>
        )}
      </Heading>
      <p>{data.summary}</p>
      <a
        class="card-more"
        href={href(domainPath(id))}
        aria-label={fr.cards.domainLabel.replace("{title}", data.title)}
      >
        <span>{fr.cards.domainMore}</span>
      </a>
      <div
        class:list={["card-back", { "is-still": modules.length < 3 }]}
        aria-hidden="true"
      >
        <div class="back-reel">
          <ul class="back-list">
            {modules.map(({ data: module }) => (
              <li>
                <strong>{module.shortTitle ?? module.title}</strong>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </li>
  ))}
  {band && (
    <li class="card reveal is-band">
      <div class="card-text">
        <Heading>{fr.cards.customTitle}</Heading>
        <p>{fr.cards.customText}</p>
      </div>
      <a class="card-more" href={href("/contact/")}>
        <span>{fr.cards.customButton}</span>
        <Icon name="right" size={18} />
      </a>
    </li>
  )}
</ul>

<script>
  import "../scripts/covers";

  // Under the pointer or with the keyboard focus, the content above the band goes up and out,
  // and the list of the modules comes up from under it at the same pace: the card keeps its
  // shape (it turned half a turn until 2026-10-29, which jerked when the pointer passed fast).
  // Only on pointer devices: touch screens keep the cards still.
  const motion = document.documentElement.dataset.motion === "on";
  const clamp = (x: number) => Math.min(1, Math.max(0, x));

  function slideCard(card: HTMLElement) {
    const back = card.querySelector(".card-back") as HTMLElement;
    const reel = back.querySelector(".back-reel") as HTMLElement;
    const list = reel.querySelector(".back-list") as HTMLElement;
    const modules = [...list.children];
    const still = back.classList.contains("is-still");
    let items: HTMLElement[] = [];
    let copies = 0;
    let offset = 0;
    let before = 0;
    let spinning = false;

    // From three modules, they scroll up without end. The reel repeats them until one cycle is
    // taller than the reel, then holds two cycles, so that it loops without a gap whatever the
    // size of the card.
    function fill() {
      const row = (list.firstElementChild as HTMLElement).offsetHeight;
      const height = reel.clientHeight;
      if (!row || !height) return false;
      const needed = Math.ceil((height / row + 1) / modules.length);
      if (needed !== copies) {
        copies = needed;
        list.replaceChildren(
          ...Array.from({ length: copies * 2 }, () =>
            modules.map((module) => module.cloneNode(true)),
          ).flat(),
        );
        items = [...list.children] as HTMLElement[];
        offset = 0;
      }
      return true;
    }

    // Each module comes in at the bottom, and near the top moves away toward the back.
    function spin(now: number) {
      if (!card.classList.contains("is-open")) {
        spinning = false;
        return;
      }
      requestAnimationFrame(spin);
      if (!fill()) return;
      const row = items[0].offsetHeight;
      const height = reel.clientHeight;
      offset =
        (offset + ((before ? now - before : 0) * row) / 1500) %
        ((row * items.length) / 2);
      before = now;
      list.style.transform = `translateY(${-offset}px)`;
      items.forEach((element, index) => {
        const place = (index * row + row / 2 - offset) / height; // 0 at the top, 1 at the bottom
        const away = clamp((0.3 - place) / 0.3);
        const coming = clamp((place - 0.72) / 0.28);
        element.style.transform = `perspective(500px) translateZ(${-away * 220}px) rotateX(${away * 38}deg) scale(${1 - coming * 0.12})`;
        element.style.opacity = String(Math.max(0, 1 - away * 1.1 - coming));
      });
    }

    // Both go by the distance from the top of the card to the band, so that the list, which
    // fills the back, comes up only under the content leaving it.
    const band = card.querySelector(".card-more") as HTMLElement;
    new ResizeObserver(() =>
      card.style.setProperty("--slide", `${band.offsetTop}px`),
    ).observe(card);
    card.classList.add("can-open");

    const open = (shown: boolean) => {
      if (shown === card.classList.contains("is-open")) return;
      card.classList.toggle("is-open", shown);
      if (shown && !still && !spinning && motion) {
        spinning = true;
        before = 0;
        requestAnimationFrame(spin);
      }
    };
    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") open(true);
    });
    card.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse")
        open(card.contains(document.activeElement));
    });
    card.addEventListener("focusin", () => open(true));
    card.addEventListener("focusout", () => open(card.matches(":hover")));
  }

  if (matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>("[data-domain]").forEach(slideCard);
  }
</script>

<style>
  /* The back covers the card above its white band, which stays in place and keeps growing a
     little under the pointer. It clips the list of the modules, which waits under it, and lets
     the pointer through to the link of the card, which covers the whole card. */
  .card-back {
    position: absolute;
    pointer-events: none;
    inset: 0 0 var(--space-14);
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--card-padding-inline);
    overflow: hidden;
    visibility: hidden;
  }

  .card.can-open .card-back {
    visibility: visible;
  }

  /* The modules scroll up without end over the whole height of the back, so that the reel is
     centered above the band. */
  .back-reel {
    position: relative;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(
      transparent,
      #000000 16%,
      #000000 84%,
      transparent
    );
  }

  /* The slide: the content above the band goes up by --slide, and the reel of the modules comes
     up from as far below (see the script). */
  .card.can-open > :not(.card-back, .card-more),
  .card.can-open .back-reel {
    transition: translate 0.6s var(--ease-in-out);
  }

  .card.can-open .back-reel {
    translate: 0 var(--slide);
  }

  .card.is-open > :not(.card-back, .card-more) {
    translate: 0 calc(-1 * var(--slide));
  }

  .card.is-open .back-reel {
    translate: none;
  }

  :global(html[data-motion="off"]) .card.can-open * {
    transition: none;
  }

  .back-list {
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }

  /* A row holds a name on two lines, should one wrap in a narrow card. */
  .back-list li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 56px;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .back-list strong {
    font: 700 var(--size-card-title) / 1.2 var(--font-title);
    letter-spacing: var(--tracking-card);
  }

  /* One or two modules: simply listed, without the reel and its fades. */
  .card-back.is-still .back-reel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    mask-image: none;
  }

  .card-back.is-still .back-list {
    display: grid;
    gap: var(--space-5);
  }

  .card-back.is-still .back-list li {
    height: auto;
  }

  /* The custom request: a band across its own row, without glass or scene. Its text sits in a
     dashed frame, open on the side of the white button, that turns white under the pointer; the
     arrow of the button moves forward instead of the button growing. From two columns the
     button is a column on the right, exactly as wide as the cards above (a subgrid of the grid
     of the cards); on a phone it is a band at the bottom. */
  .card.is-band {
    grid-column: 1 / -1;
    gap: 0;
    padding: 0;
    background: none;
  }

  .card.is-band:hover {
    background: none;
  }

  .card-text {
    display: grid;
    gap: var(--space-3);
    padding: var(--card-padding-block) var(--card-padding-inline);
    border: 1px dashed var(--line-strong);
    border-bottom-width: 0;
    transition: border-color var(--duration-fast);
  }

  .card.is-band:hover .card-text {
    border-color: var(--text);
  }

  .card.is-band .card-more {
    margin: 0;
  }

  .card.is-band:hover .card-more {
    padding-block: var(--space-4);
  }

  /* The arrow only from two columns; on a phone the band stays a plain button, as on the other
     cards. */
  .card.is-band .card-more :global(svg) {
    display: none;
    margin-left: var(--space-3);
    transition: transform var(--duration-fast);
  }

  .card.is-band:hover .card-more :global(svg) {
    transform: translateX(6px);
  }

  @media (width >= 640px) {
    .card.is-band {
      display: grid;
      grid-template-columns: subgrid;
      column-gap: normal;
    }

    /* The frame runs over the gap of the grid, up to the button. */
    .card-text {
      grid-column: 1 / -2;
      margin-right: calc(-1 * var(--cards-gap));
      border-right-width: 0;
      border-bottom-width: 1px;
    }

    .card.is-band .card-more {
      grid-column: -2 / -1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card.is-band .card-more :global(svg) {
      display: block;
      flex: none;
    }
  }
</style>
