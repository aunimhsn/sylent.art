---
// Icons as SVG lines in the text color (docs/branding.md, Icons and images).
const paths = {
  menu: "M4 8h16M4 16h16",
  close: "M6 6l12 12M18 6L6 18",
  up: "M6 15l6-6 6 6",
  down: "M6 9l6 6 6-6",
  check: "M5 12.5l4.5 4.5L19 7.5",
  right: "M5 12h14M13 6l6 6-6 6",
};

interface Props {
  name: keyof typeof paths;
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
