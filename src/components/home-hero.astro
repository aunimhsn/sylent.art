---
// The hero of the home page: the headline, the trainer and the audiences, the two buttons and
// the motto, beside the cube (src/scripts/cube.ts), over a grid where an orange fluid follows the
// pointer (src/scripts/grid-fluid.ts, loaded by the footer).
import { getImage } from "astro:assets";
import portrait from "../assets/portrait/face.png";
import home from "../content/home.json";
import pedagogy from "../content/pedagogy.json";
import fr from "../i18n/fr.json";
import { bearingStyle } from "../lib/title-metrics";
import { href } from "../lib/url";

// The faces of the cube: a label over a word, over one of the key figures, written once in
// pedagogy.json and named by its id (an unknown id fails the build), or over the owner's face,
// which the cube presents first: only the first face may show it.
const faces = home.cube.map((face, index) => {
  if (face.photo) {
    if (index > 0)
      throw new Error("home.json: the photo face of the cube comes first");
    return [face.label, ""];
  }
  if (face.figure === undefined) return [face.label, face.value];
  const figure = pedagogy.figures.find(({ id }) => id === face.figure);
  if (!figure)
    throw new Error(`home.json: unknown key figure "${face.figure}"`);
  return [face.label, `${figure.value}${figure.unit}`];
});
const photo = home.cube[0]?.photo
  ? await getImage({ src: portrait, format: "webp" })
  : undefined;
---

<section
  class="hero grid-texture"
  id="hero"
  aria-labelledby="hero-title"
  data-fluid="--grid-step"
>
  <canvas
    class="hero-canvas"
    id="cube-canvas"
    aria-hidden="true"
    data-faces={JSON.stringify(faces)}
    data-photo={photo?.src}
  ></canvas>
  <div class="wrap">
    <div class="hero-text">
      <h1
        class="hero-title intro"
        id="hero-title"
        style={bearingStyle(home.hero.title)}
      >
        {home.hero.title} <span class="highlight">{home.hero.highlight}</span>
      </h1>
      <p class="hero-sub intro">
        <strong>{home.hero.name}</strong>
        {home.hero.sub}
      </p>
      <div class="hero-actions intro">
        <a class="button magnetic" href={href("/contact/")}>
          {home.hero.contact}
        </a>
        <a class="button is-outline" href="#formations">
          {home.hero.courses}
        </a>
      </div>
      <p class="motto hero-motto intro">{fr.site.motto}</p>
    </div>
    <div class="hero-visual" id="cube-area" aria-hidden="true"></div>
  </div>
</section>

<!--
  The elements of the intro stay hidden until src/scripts/hero-intro.ts starts it; if it hasn't
  after 4 s (a script that failed), they show.
-->
<script is:inline>
  setTimeout(() => {
    document.documentElement.dataset.introStarted ??= "fallback";
  }, 4000);
</script>

<script>
  import "../scripts/hero-intro";
  // Three.js is large: the intro, which shows the headline, doesn't wait for it.
  import("../scripts/cube");
</script>

<style>
  /* The grid and its orange fluid (global.css), under the cube, with this mask. */
  .hero {
    --grid-mask: radial-gradient(
      80% 70% at 70% 40%,
      #000000 30%,
      transparent 75%
    );

    overflow: hidden;
    padding: calc(var(--header-height) + var(--space-10)) 0 var(--space-14);
    background:
      radial-gradient(55% 50% at 78% 45%, var(--glow), transparent 70%),
      var(--bg);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wrap {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  .hero-text {
    position: relative;
    z-index: 2;
  }

  /* The ink of the first letter on the left edge, not its side bearing (--bearing, optical
     alignment, docs/branding.md). */
  .hero-title {
    margin: 0 0 0 calc(-1 * var(--bearing));
    font: var(--title-weight) var(--size-display) / 0.98 var(--font-title);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .hero-sub {
    margin: var(--space-7) 0 0;
    max-width: var(--measure-narrow);
    color: var(--secondary);
    font-size: var(--size-intro);
    text-wrap: pretty;
  }

  .hero-sub strong {
    color: var(--text);
    font-weight: inherit;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-9);
  }

  .hero-motto {
    margin-top: var(--space-10);
  }

  /* The area of the cube, which a drag spins. */
  .hero-visual {
    position: relative;
    height: 380px;
    cursor: grab;
    touch-action: pan-y;
  }

  .hero-visual:active {
    cursor: grabbing;
  }

  @media (width >= 900px) {
    .hero {
      display: grid;
      align-items: center;
      min-height: min(100svh, 880px);
      padding-bottom: var(--space-18);
    }

    .wrap {
      grid-template-columns: 7fr 5fr;
      align-items: center;
    }

    .hero-visual {
      height: 540px;
    }
  }

  /* The starting state of the intro (src/scripts/hero-intro.ts), only when it runs. */
  :global(html[data-motion="on"].is-js:not([data-intro-started])) .intro {
    visibility: hidden;
  }
</style>
