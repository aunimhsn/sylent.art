---
// Section heading, after the former site: a title over a large faded word. The title rises and
// the word slides as the page scrolls (src/scripts/motion.ts).
// The title is in capitals and drops its accents, which the mask of its animation would cut
// (« PEDAGOGIE »): an exception to French typography accepted by the owner (CLAUDE.md). Screen
// readers keep the real words through aria-label.
import { withoutAccents } from "../lib/text";
import { bearingStyle } from "../lib/title-metrics";

interface Props {
  title: string;
  ghost: string;
  id: string;
  level?: 1 | 2;
  /** A shorter title shown below 640 px, where the title doesn't fit (the not-found page). */
  short?: string;
}

const { title, ghost, id, level = 2, short } = Astro.props;
const shown = withoutAccents(title);
const shortShown = short && withoutAccents(short);
const ghostShown = withoutAccents(ghost).toUpperCase();
const Title = `h${level}` as const;
---

<div class="heading">
  <span
    class="ghost-word heading-ghost"
    style={bearingStyle(ghostShown)}
    aria-hidden="true"
  >
    {ghostShown}
  </span>
  {shortShown ? (
    <Title class="heading-title" id={id} aria-label={title}>
      <span
        class="heading-part is-wide"
        style={bearingStyle(shown.toUpperCase())}
      >
        {shown}
      </span>
      <span
        class="heading-part is-short"
        style={bearingStyle(shortShown.toUpperCase())}
      >
        {shortShown}
      </span>
    </Title>
  ) : (
    <Title
      class="heading-title"
      id={id}
      style={bearingStyle(shown.toUpperCase())}
      aria-label={shown === title ? undefined : title}
    >
      {shown}
    </Title>
  )}
</div>

<style>
  .heading {
    position: relative;
    container-type: inline-size;
    margin-bottom: var(--space-fluid-2);
    padding-top: var(--space-fluid-1);
  }

  /* The title and the faded word start from the ink of their first letter, not its side bearing
     (--bearing, optical alignment chosen by the owner on 2026-10-30), the word 0.12 em further
     right. */
  .heading-ghost {
    display: block;
    margin-left: calc(0.12em - var(--bearing, 0em));
  }

  /* On a phone the title holds on one line (asked by the owner on 2026-10-29): its size follows
     the width of the heading, so that the longest one, « DANS LA MEME FORMATION » (12.4 em),
     fits; on a wider screen the section size is the smaller of the two. */
  .heading-title {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0 0 0 calc(-1 * var(--bearing, 0em));
    font: var(--title-weight) var(--size-section) / 1 var(--font-title);

    /* Apart from the shorthand: a browser without the cqi unit keeps the font and the size. */
    font-size: min(var(--size-section), 7.6cqi);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
  }

  /* With a short title, each part starts from the ink of its own first letter; the title shows
     from 640 px, the short one below. */
  .heading-part {
    display: inline-block;
    margin-left: calc(-1 * var(--bearing, 0em));
  }

  .heading-part.is-wide {
    display: none;
  }

  @media (width >= 640px) {
    .heading-part.is-wide {
      display: inline-block;
    }

    .heading-part.is-short {
      display: none;
    }
  }

  /* A lead right under a heading comes closer to it. */
  .heading + :global(.lead) {
    margin-top: calc(-1 * var(--space-fluid-1));
    margin-bottom: var(--space-fluid-2);
  }
</style>
