---
// Section heading, after the former site: a title over a large faded word. The title rises and
// the word slides as the page scrolls (src/scripts/motion.ts).
// The title is in capitals and drops its accents, which the mask of its animation would cut
// (« PEDAGOGIE »): an exception to French typography accepted by the owner (CLAUDE.md). Screen
// readers keep the real words through aria-label.
import { withoutAccents } from "../lib/text";

interface Props {
  title: string;
  ghost: string;
  id: string;
  level?: 1 | 2;
}

const { title, ghost, id, level = 2 } = Astro.props;
const shown = withoutAccents(title);
const Title = `h${level}` as const;
---

<div class="heading">
  <span class="ghost-word heading-ghost" aria-hidden="true">
    {ghost}
  </span>
  <Title
    class="heading-title"
    id={id}
    aria-label={shown === title ? undefined : title}
  >
    {shown}
  </Title>
</div>

<style>
  .heading {
    position: relative;
    container-type: inline-size;
    margin-bottom: var(--space-fluid-2);
    padding-top: var(--space-fluid-1);
  }

  .heading-ghost {
    display: block;
    margin-left: 0.12em;
  }

  /* On a phone the title holds on one line (asked by the owner on 2026-10-29): its size follows
     the width of the heading, so that the longest one, « DANS LE MEME DOMAINE » (11.2 em),
     fits; on a wider screen the section size is the smaller of the two. */
  .heading-title {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    font: var(--title-weight) var(--size-section) / 1 var(--font-title);

    /* Apart from the shorthand: a browser without the cqi unit keeps the font and the size. */
    font-size: min(var(--size-section), 8.5cqi);
    letter-spacing: var(--tracking-title);
    text-transform: uppercase;
  }

  /* A lead right under a heading comes closer to it. */
  .heading + :global(.lead) {
    margin-top: calc(-1 * var(--space-fluid-1));
    margin-bottom: var(--space-fluid-2);
  }
</style>
