---
// The hero of a module, formation or domain page, over the grid and its orange fluid
// (global.css): the « Nouveau » label of a new domain, the title, over a large faded word on a
// module page, a line right under it (the slot "under": the mark of a framework), the lead (the
// slot), the note of a new domain, then the actions, if any (the slot "actions"). The slot
// "aside" takes a column on the right on a computer and comes after the lead on a phone (the
// domains of a formation).
import fr from "../i18n/fr.json";
import { withoutAccents } from "../lib/text";
import {
  bearingStyle,
  TRACKING_GHOST,
  TRACKING_TITLE,
  widthEm,
} from "../lib/title-metrics";

interface Props {
  title: string;
  /** The large faded word behind the title, hidden from screen readers; none on a domain page,
   * which the domains list already announces (asked by the owner on 2026-10-29). */
  ghost?: string;
  id: string;
  /** Said to screen readers after the title, e.g. the formation of a module. */
  label?: string;
  isNew?: boolean;
  note?: string;
}

const { title, ghost, id, label, isNew = false, note } = Astro.props;
// The faded word as shown: in capitals, without accents.
const ghostShown = ghost && withoutAccents(ghost).toUpperCase();
// The widths of the title and of the faded word in em, from which their sizes follow the width of
// the heading (below). The title keeps 5 % more and 0.04 em of air: Chromium on Linux sets each
// letter on a whole pixel, which makes a title up to 4.4 % wider at 38 px; the faded word keeps
// its offset of 0.12 em.
const sizes = {
  "--title-em": (widthEm(title, TRACKING_TITLE) * 1.05 + 0.04).toFixed(3),
  ...(ghostShown && {
    "--ghost-em": (widthEm(ghostShown, TRACKING_GHOST) + 0.12).toFixed(3),
  }),
};
---

<section
  class="page-hero grid-texture"
  aria-labelledby={id}
  data-fluid="--grid-step"
>
  <div class:list={["wrap", { "has-aside": Astro.slots.has("aside") }]}>
    <div>
      {isNew && (
        <p class="page-new reveal">
          <span class="new">{fr.cards.new}</span>
        </p>
      )}
      <div class="page-heading" style={sizes}>
        {ghostShown && (
          <span
            class="ghost-word heading-ghost"
            style={bearingStyle(ghostShown)}
            aria-hidden="true"
          >
            {ghostShown}
          </span>
        )}
        <div class="page-titles">
          <h1 class="page-title reveal" id={id} style={bearingStyle(title)}>
            {title}
          </h1>
          <slot name="under" />
        </div>
      </div>
      {label && <p class="visually-hidden">{label}</p>}
      <div class="page-lead reveal">
        <slot />
      </div>
      {note && <p class="page-note note reveal">{note}</p>}
      {Astro.slots.has("actions") && (
        <div class="page-actions reveal">
          <slot name="actions" />
        </div>
      )}
    </div>
    {Astro.slots.has("aside") && (
      <div class="page-aside reveal">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    --grid-mask: radial-gradient(
      80% 75% at 70% 40%,
      #000000 30%,
      transparent 75%
    );

    padding: calc(var(--header-height) + var(--space-fluid-2)) 0
      var(--space-fluid-3);
  }

  .page-hero .wrap {
    position: relative;
  }

  .page-new {
    margin: 0 0 var(--space-6);
  }

  .page-new .new {
    position: static;
    display: inline-block;
  }

  /* With an aside: one column on a phone, the aside after the lead; two columns from 900 px,
     the aside on the right, its bottom on the bottom of the lead. */
  .page-hero .has-aside {
    display: grid;
    gap: var(--space-10);
  }

  @media (width >= 900px) {
    .page-hero .has-aside {
      grid-template-columns: 7fr 4fr;
      gap: var(--space-18);
      align-items: end;
    }
  }

  /* The title over the faded word, a little lower and to the right, as in the section
     headings (src/components/section-heading.astro): both in the same cell of a grid, so that
     the taller of the two sets the height. The word slides with the scroll
     (src/scripts/motion.ts). */
  .page-heading {
    /* The title holds on one line at every width (asked by the owner on 2026-10-29): it takes the
       whole width of the page, not the column of the lead, where « Développement web » broke
       mid-word on a computer, and it is as large as the display size allows within that width,
       from its own width in em (--title-em), so that a short title keeps the display size
       (« Laravel » 44 px on a phone) and only a long one shrinks (asked by the owner on
       2026-10-30, instead of one size for every title, sized on the longest). What follows the
       title (the slot "under") is placed from this size. Without its width, a title takes the
       size of the longest one (10.5 em), and a faded word the size of the faded words. */
    --title-size: min(
      var(--size-display),
      calc(100cqi / var(--title-em, 10.5))
    );

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    container-type: inline-size;
  }

  .page-heading > * {
    grid-area: 1 / 1;
  }

  /* The faded word takes 60 % of the width of the heading (chosen by the owner on 2026-10-30),
     from its width in em (--ghost-em), between the size of the faded words and their largest
     size: a short word (« PHP ») grows on a phone, where the title grew too, and a long one
     (« JAVASCRIPT ») keeps the size of the faded words and may run past the screen. */
  .heading-ghost {
    margin: var(--space-fluid-1) 0 0 calc(0.12em - var(--bearing, 0em));
    font-size: max(
      var(--size-ghost),
      min(176px, calc(60cqi / var(--ghost-em, 99)))
    );
  }

  /* The title and the line right under it, over the faded word. */
  .page-titles {
    position: relative;
    align-self: start;
  }

  /* The ink of the first letter on the left edge, not its side bearing (--bearing, optical
     alignment chosen by the owner on 2026-10-30); the faded word keeps its offset of 0.12 em from
     its ink. */
  .page-title {
    margin: 0 0 0 calc(-1 * var(--bearing, 0em));
    font: var(--title-weight) var(--title-size) / 0.98 var(--font-title);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;

    /* No hyphenation, which split « Prompt engineering » mid-word: a word wider than the
       screen breaks without a hyphen rather than overflow. */
    overflow-wrap: break-word;
  }

  .page-lead :global(p) {
    margin: var(--space-7) 0 0;
    max-width: var(--measure);
    color: var(--secondary);
    font-size: var(--size-intro);
    text-wrap: pretty;
  }

  .page-lead :global(p + p) {
    margin-top: var(--space-4);
  }

  .page-note {
    margin: var(--space-6) 0 0;
    max-width: var(--measure-narrow);
    padding: var(--space-3) var(--space-4);
    font-size: var(--size-text-small);
  }

  /* The buttons one under the other and full width on a phone, side by side from 640 px. */
  .page-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-9);
  }

  @media (width >= 640px) {
    .page-actions {
      flex-flow: row wrap;
    }
  }
</style>
