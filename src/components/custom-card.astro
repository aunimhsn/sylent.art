---
// The eighth card after the seven domains of the home page and the formations page (asked by the
// owner on 2026-10-30, instead of a band across its own row): a module built for the request, with
// its own scene, that leads to the contact page. It doesn't tilt, as the domain cards beside it.
// Under the formations of a domain page, the same request is a band (custom-band.astro).
import fr from "../i18n/fr.json";
import { href } from "../lib/url";

interface Props {
  /** 2 on the formations page, right under its h1; 3 on the home page. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<li class="card glass reveal">
  <div class="cover" data-scene="custom" aria-hidden="true">
    <canvas></canvas>
  </div>
  <Heading>{fr.cards.customTitle}</Heading>
  <p>{fr.cards.customText}</p>
  <a class="card-more" href={href("/contact/")}>
    {fr.cards.customButton}
  </a>
</li>

<script>
  import "../scripts/covers";
</script>
