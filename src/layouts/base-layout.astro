---
// The document shared by every page: language, metadata, fonts and base styles.
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Under a base path, the site is the preview at its github.io address, which search engines
// must not index beside the former site.
const isPreview = import.meta.env.BASE_URL !== "/";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-anaheim" preload />
    <!--
      Before the first paint, so that nothing flashes: data-motion is off when the visitor asked
      their system to reduce motion (or with ?motion=off, for checks and screenshots), and is-js
      hides the elements that the animations reveal. If the animations haven't started after 4 s
      (a script that failed), everything shows.
    -->
    <script is:inline>
      {
        const root = document.documentElement;
        const reduced =
          new URLSearchParams(location.search).get("motion") === "off" ||
          matchMedia("(prefers-reduced-motion: reduce)").matches;
        root.dataset.motion = reduced ? "off" : "on";
        root.classList.add("is-js");
        setTimeout(() => {
          if (!root.dataset.motionStarted) root.classList.remove("is-js");
        }, 4000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
