---
// The document shared by every page: language, metadata, fonts and base styles.
import { Font, getImage } from "astro:assets";
import socialCard from "../assets/brand/social-card.png";
import fr from "../i18n/fr.json";
import { href } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** A page that search engines must not index, as the not-found page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Under a base path, the site is the preview at its github.io address, which search engines
// must not index beside the former site.
const isPreview = import.meta.env.BASE_URL !== "/";
// The visits are counted by GoatCounter on sylent.art only: not on the preview, nor on the
// development server (docs/external-services.md). Its script ignores localhost by itself, so
// the checks, which serve the build locally, count nothing either. Its version is pinned, with
// the hash that GoatCounter publishes: the browser refuses a file that doesn't match it.
const counts = import.meta.env.PROD && !isPreview;
// The card that LinkedIn and Facebook show for a link to any page: its title, its description
// and one image of 1200 × 630 px, the logo and the address over the faded photo of the owner
// (docs/branding.md, Preview card). The networks want an absolute URL, and read JPEG
// everywhere, WebP not always. X reads twitter:card to show the large card, and the rest from
// the Open Graph tags.
const card = await getImage({
  src: socialCard,
  format: "jpeg",
  width: 1200,
  height: 630,
  quality: 85,
});
const cardUrl = new URL(card.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!--
      The mark of the logo, white on the background of the site (docs/branding.md, Logo):
      SVG for the browsers that read it, ICO (16, 32, 48 px) for the others and for Google,
      which looks for /favicon.ico, and a PNG of 180 px for a shortcut on an iPhone.
    -->
    <link rel="icon" href={href("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {(isPreview || noindex) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={fr.site.name} />
    <meta property="og:locale" content={fr.site.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(card.attributes.width)} />
    <meta property="og:image:height" content={String(card.attributes.height)} />
    <meta property="og:image:alt" content={fr.site.cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {counts && (
      <script
        is:inline
        data-goatcounter="https://sylent.goatcounter.com/count"
        async
        src="https://gc.zgo.at/count.v5.js"
        crossorigin="anonymous"
        integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"
      />
    )}
    <Font cssVariable="--font-manrope" preload />
    <Font cssVariable="--font-anaheim" preload />
    <!--
      Before the first paint, so that nothing flashes: data-motion is off when the visitor asked
      their system to reduce motion (or with ?motion=off, for checks and screenshots), and is-js
      hides the elements that the animations reveal. If the animations haven't started after 4 s
      (a script that failed), everything shows.
    -->
    <script is:inline>
      {
        const root = document.documentElement;
        const reduced =
          new URLSearchParams(location.search).get("motion") === "off" ||
          matchMedia("(prefers-reduced-motion: reduce)").matches;
        root.dataset.motion = reduced ? "off" : "on";
        root.classList.add("is-js");
        setTimeout(() => {
          if (!root.dataset.motionStarted) root.classList.remove("is-js");
        }, 4000);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
